# Copier en .env et ajuster.

# Moteur de résumé : "gemini" | "cli" | "api"
#   gemini — API Gemini, tier gratuit (recommandé : la clé n'expire pas, contrairement
#            au token OAuth du CLI qui casse une exécution planifiée)
#   cli    — binaire claude, abonnement Claude Code (nécessite une session authentifiée)
#   api    — SDK anthropic, facturé à l'usage
VEILLE_BACKEND=gemini

# Requis si VEILLE_BACKEND=gemini — clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Identifiant du modèle Gemini. Ces identifiants changent souvent :
# `python -m veille.summarize --modeles-gemini` liste ceux que la clé peut appeler.
VEILLE_MODELE_GEMINI=gemini-3.6-flash

# Requis si VEILLE_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...
# VEILLE_MODELE=claude-sonnet-5

# Racine du vault Obsidian. Par défaut : le dossier parent de `.veille/`.
# VAULT_PATH=/chemin/vers/le/vault

# Sous-dossier de la veille à l'intérieur du vault
# VAULT_DOSSIER=Veille IA
